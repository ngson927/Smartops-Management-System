
# ==========================================
# SMARTOPS LOCAL ENVIRONMENT EXAMPLE
# ==========================================

# Flask Security
SECRET_KEY=replace-with-a-long-random-secret

# Local MySQL
DB_USER=smartops_user
DB_PASSWORD=replace-with-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartops_db

# HTTP locally, HTTPS on Railway
SESSION_COOKIE_SECURE=false

# ==========================================
# RAILWAY ENVIRONMENT
# ==========================================

# On Railway, configure SECRET_KEY and
# reference the MySQL service variables:
#
# MYSQLHOST
# MYSQLPORT
# MYSQLUSER
# MYSQLPASSWORD
# MYSQLDATABASE
#
# Do not place real credentials in this file.
